# BeatWave — Apache Config
Options -Indexes
ServerSignature Off

# ── Rewrite Engine ─────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /music-platform/

  # HTTPS redirect (enable in production)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove trailing slashes
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Route error pages
  ErrorDocument 403 /music-platform/403.php
  ErrorDocument 404 /music-platform/404.php
  ErrorDocument 500 /music-platform/500.php
</IfModule>

# ── Security Headers ────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Cache Control ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp         "access plus 1 year"
  ExpiresByType image/jpeg         "access plus 1 year"
  ExpiresByType image/png          "access plus 1 year"
  ExpiresByType image/svg+xml      "access plus 1 year"
  ExpiresByType text/css           "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json   "access plus 1 day"
  ExpiresByType audio/mpeg         "access plus 1 month"
  ExpiresByType audio/mp4          "access plus 1 month"
</IfModule>

# ── Gzip Compression ────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml
</IfModule>

# ── Block sensitive directories ──────────────────────────────
<FilesMatch "\.(env|log|sql|md|git)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block direct access to config/core
<IfModule mod_rewrite.c>
  RewriteRule ^(config|core|database|cron)/ - [F,L]
</IfModule>

# ── PHP Settings ─────────────────────────────────────────────
<IfModule mod_php.c>
  php_value upload_max_filesize 50M
  php_value post_max_size       55M
  php_value max_execution_time  120
  php_value memory_limit        256M
</IfModule>
